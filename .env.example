# Copie para .env.local somente quando precisar personalizar a demonstração.
# API local; para aparelho físico, use o IPv4 LAN do computador e ASSISTANT_HOST=0.0.0.0.
# Android emulador: use http://10.0.2.2:8090 em vez de localhost.
EXPO_PUBLIC_ASSISTANT_API_URL=http://localhost:8090
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=8090
ASSISTANT_DB_PATH=.cache/assistant/demo.sqlite
ASSISTANT_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Opcional: senha forte de pelo menos 16 caracteres. Sem valor, é gerada no terminal.
# ASSISTANT_ADMIN_PASSWORD=
ASSISTANT_DEMO_MODE=true
